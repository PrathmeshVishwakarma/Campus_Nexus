# Local development settings (copy to backend/.env). All values are optional.
# Default database: SQLite file next to this one.
# DATABASE_URL=sqlite:///./campus_nexus.db
# Leave SECRET_KEY unset to auto-generate one in DATA_DIR/secret_key.
# SECRET_KEY=
# Shared root folder (relative paths are resolved from the project root).
# SHARED_FOLDER=shared/demo_files
# Server-private storage: upload staging, version history, ML state.
# DATA_DIR=data
# Comma-separated usernames that are always admins.
# ADMIN_USERNAMES=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
